{
  "name": "mypetcare",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": { "node": ">=22.12.0", "pnpm": ">=12.0.0" },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @mypetcare/database db:generate",
    "db:migrate": "pnpm --filter @mypetcare/database db:migrate",
    "db:studio": "pnpm --filter @mypetcare/database db:studio"
  },
  "devDependencies": { "turbo": "^2.5.0" }
}
